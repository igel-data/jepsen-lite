{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        jepsen/jepsen       {:mvn/version "0.3.12"}}

 :aliases
 {;; The demo is example consumer code, not part of the library, so it is not
  ;; on :paths -- it comes in only for these aliases.
  :run  {:extra-paths ["examples"]
         :main-opts   ["-m" "demo.kvs"]}

  ;; The `:http` demo comes in two halves, in two terminals: the store, which
  ;; runs outside Lite and knows nothing about it, and Lite connecting to it.
  ;; Keeping them apart is the point -- an `:http` target is one Lite doesn't
  ;; run, so nothing here lets Lite start one.
  :serve    {:extra-paths ["examples"]
             :main-opts   ["-m" "demo.http-server"]}
  :run-http {:extra-paths ["examples"]
             :main-opts   ["-m" "demo.http-kvs"]}

  ;; The `:local-process` demo needs only one terminal: Lite starts the same
  ;; store itself, as a program it can kill.
  :run-local {:extra-paths ["examples"]
              :main-opts   ["-m" "demo.local-kvs"]}

  ;; The store in a container, where the faults include partition. Needs
  ;; Docker running; Lite brings the service up and down around the run.
  :run-compose {:extra-paths ["examples"]
                :main-opts   ["-m" "demo.compose-kvs"]}

  ;; Note the absence of "examples": the test suite stands on its own, on
  ;; fixtures in test/. The demo is documentation, not a dependency of it.
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}}}
