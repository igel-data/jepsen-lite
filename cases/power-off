#!/usr/bin/env bash
#
# Runs a store's suite inside the lazyfs container, for the :power-off nemesis.
#
#   cases/power-off sqlite set power-off
#   cases/power-off lmdb   set power-off sync=off
#   cases/power-off sqlite bank power-off time=30 concurrency=8
#
# The first argument is the case; the rest go to `clojure -M:jepsen` unchanged,
# so anything the runner accepts works here too.
#
# Every other fault runs natively -- `cd cases/sqlite && clojure -M:jepsen set
# kill`. This wrapper exists only because lazyfs is FUSE, and FUSE means Linux.
#
# --device /dev/fuse and --cap-add SYS_ADMIN are what let a FUSE filesystem be
# mounted inside the container; without them lazyfs cannot start, and Jepsen
# Lite refuses the run rather than quietly falling back to a plain crash.
set -euo pipefail

IMAGE=${IMAGE:-jepsen-lite-lazyfs}
# The whole repository, not just cases/: a case depends on Jepsen Lite through
# :local/root "../..", so the source it builds against has to be inside the
# container too.
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

if [ $# -lt 1 ]; then
    echo "usage: cases/power-off <case> [args...]" >&2
    echo "   e.g. cases/power-off lmdb set power-off" >&2
    exit 2
fi

case_name=$1
shift

if [ ! -d "$REPO/cases/$case_name" ]; then
    echo "no such case: $case_name (expected $REPO/cases/$case_name)" >&2
    exit 2
fi

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "Building $IMAGE (once; lazyfs is compiled from source)..." >&2
    docker build -t "$IMAGE" -f "$REPO/cases/docker/Dockerfile" "$REPO/cases/docker"
fi

# Named volumes for the dependency caches, rather than the host's: the container
# runs as root, and letting it write to a developer's ~/.m2 would leave
# root-owned files behind in it.
exec docker run --rm \
    --device /dev/fuse \
    --cap-add SYS_ADMIN \
    --security-opt apparmor=unconfined \
    -v "$REPO":/work \
    -v jepsen-lite-m2:/root/.m2 \
    -w "/work/cases/$case_name" \
    "$IMAGE" \
    clojure -M:jepsen "$@"
